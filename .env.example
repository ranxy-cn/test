# DevOpsAgent 环境变量
# 复制为 .env 后按需修改。不配置真实凭据时全程走 mock，demo 默认可跑。

WEBHOOK_SECRET=dev-webhook-secret
# MySQL 连接串（密码含 @ 等特殊字符需 URL 编码，如 @ → %40）
# docker 部署默认连 compose 内置 mysql（COMPOSE_PROFILES=bundled-db 时启动）
DATABASE_URL=mysql+pymysql://devops_agent:devops_agent@mysql:3306/devops_agent?charset=utf8mb4
REDIS_URL=redis://redis:6379/0
USE_CELERY=true
DEMO_MODE=true

# ===== 登录鉴权 / RBAC =====
# JWT 签名密钥：生产必须设置为 >=32 位随机串（openssl rand -hex 32）
JWT_SECRET=
# 访问令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=720
# 初始 admin 密码（仅首次启动建库时使用，登录后请立即修改）
ADMIN_INITIAL_PASSWORD=

# 演示模式观察期（秒）。生产建议 600。
OBSERVATION_SECONDS=10
PROBE_REQUIRED_PASSES=3
PROBE_INTERVAL_SECONDS=1
RESTART_COOLDOWN_SECONDS=1800
ACTION_FAIL_COOLDOWN_SECONDS=1800
LOCK_TTL_SECONDS=120

# 集成模式：mock（默认）| real。real 缺少配置时自动回退 mock。
INTEGRATION_MODE=mock
# 分项覆盖（留空则跟随 INTEGRATION_MODE）
ANSIBLE_MODE=
VAULT_MODE=

# 平台对外可访问的基础 URL（如 http://1.2.3.4:8000）。
# 子机 agent 上报地址由它拼接；未配置时回退为请求的 base_url。
PLATFORM_PUBLIC_URL=

# 真实 Vault（可选）。短凭证只在执行器内使用，不进入 LLM。
VAULT_ADDR=
VAULT_TOKEN=

# 真实 Ansible。默认 mock。不要把私钥提交进仓库。
# pip install ansible-runner   # 或系统包 ansible
ANSIBLE_RUNNER_ENABLED=false
ANSIBLE_MODE=
ANSIBLE_PRIVATE_DATA_DIR=/tmp/ansible-runner
ANSIBLE_INVENTORY=
ANSIBLE_ROLES_PATH=
ANSIBLE_SSH_PRIVATE_KEY_FILE=
ANSIBLE_SSH_USER=devops
ANSIBLE_CHECK_MODE=false
ANSIBLE_TIMEOUT_SECONDS=120
ANSIBLE_HOST_KEY_CHECKING=true

# 可选通知 Webhook。工作台通知列表始终可用。
NOTIFY_WEBHOOK_URL=

# OpenAI 兼容接口（可选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

POLICY_VERSION=policy-v1.0.0
TENANT_ID=tenant-default
EMPLOYEE_ID=DE-OPS-001
