# DevOpsAgent 环境变量
# 复制为 .env 后按需修改。不配置真实凭据时全程走 mock，demo 默认可跑。

WEBHOOK_SECRET=dev-webhook-secret
# 工作台登录（HMAC JWT）。以下为本地演示默认值，生产请自行替换，不要把真实密码提交进仓库。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
AUTH_TOKEN_SECRET=dev-auth-token-secret
AUTH_TOKEN_TTL_SECONDS=86400
AUTH_TOKEN_ALGORITHM=HS256
DATABASE_URL=postgresql+psycopg2://devops:devops@postgres:5432/devops_agent
REDIS_URL=redis://redis:6379/0
USE_CELERY=true
DEMO_MODE=true

# 演示模式观察期（秒）。生产建议 600。
OBSERVATION_SECONDS=10
PROBE_REQUIRED_PASSES=3
PROBE_INTERVAL_SECONDS=1
RESTART_COOLDOWN_SECONDS=1800
ACTION_FAIL_COOLDOWN_SECONDS=1800
LOCK_TTL_SECONDS=120

# 集成模式：mock（默认）| real。real 缺少 URL/Token 时自动回退 mock。
INTEGRATION_MODE=mock
# 分项覆盖（留空则跟随 INTEGRATION_MODE）
ZABBIX_MODE=
ANSIBLE_MODE=
VAULT_MODE=

# 真实 Zabbix 只读 API（可选）。不要给写权限。
# ZABBIX_MODE=mock|real|auto（auto：有 URL+凭据且 health 通过才用 real）
ZABBIX_URL=
ZABBIX_TOKEN=
ZABBIX_USER=
ZABBIX_PASSWORD=
# 真实告警 e2e：export 上述变量后 docker compose up，再 ./scripts/e2e_real_zabbix.sh
# 不要把密码提交进仓库。
ZABBIX_VERIFY_SSL=true
ZABBIX_TIMEOUT_SECONDS=8
ZABBIX_RETRIES=2

# 真实 Vault（可选）。短凭证只在执行器内使用，不进入 LLM。
VAULT_ADDR=
VAULT_TOKEN=

# 真实 Ansible。默认 mock；缺 runner / 未设 ANSIBLE_MODE=real 时自动回退 mock。
# pip install ansible-runner   # 或系统包 ansible
# 无远端主机：cp inventory/demo.ini.example inventory/demo.ini
#   export ANSIBLE_MODE=real ANSIBLE_RUNNER_ENABLED=true
#   export ANSIBLE_INVENTORY=$PWD/inventory/demo.ini ANSIBLE_CHECK_MODE=true
ANSIBLE_RUNNER_ENABLED=false
ANSIBLE_MODE=
ANSIBLE_PRIVATE_DATA_DIR=/tmp/ansible-runner
ANSIBLE_INVENTORY=
ANSIBLE_ROLES_PATH=
ANSIBLE_SSH_PRIVATE_KEY_FILE=
ANSIBLE_SSH_USER=devops
ANSIBLE_CHECK_MODE=false
ANSIBLE_TIMEOUT_SECONDS=120
ANSIBLE_HOST_KEY_CHECKING=true

# 可选通知 Webhook。工作台通知列表始终可用。
NOTIFY_WEBHOOK_URL=

# OpenAI 兼容接口（可选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

POLICY_VERSION=policy-v1.0.0
TENANT_ID=tenant-default
EMPLOYEE_ID=DE-OPS-001
