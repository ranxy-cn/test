# DevOpsAgent 一期 MVP 环境变量
# 复制为 .env 后按需修改。不配置 OPENAI_API_KEY 时使用确定性 Mock 诊断器。

WEBHOOK_SECRET=dev-webhook-secret
DATABASE_URL=postgresql+psycopg2://devops:devops@postgres:5432/devops_agent
REDIS_URL=redis://redis:6379/0
USE_CELERY=true
DEMO_MODE=true

# 演示模式观察期（秒）。生产建议 600。
OBSERVATION_SECONDS=10
PROBE_REQUIRED_PASSES=3
PROBE_INTERVAL_SECONDS=1
RESTART_COOLDOWN_SECONDS=1800

# OpenAI 兼容接口（可选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

POLICY_VERSION=policy-v1.0.0
TENANT_ID=tenant-default
EMPLOYEE_ID=DE-OPS-001
